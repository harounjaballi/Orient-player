# SUPABASE_URL: URL REST de votre projet Supabase (configurée via le panneau Secrets d'AI Studio)
SUPABASE_URL=https://your-project-id.supabase.co

# SUPABASE_ANON_KEY: Clé API publique (anon key) de votre projet Supabase (configurée via le panneau Secrets d'AI Studio)
SUPABASE_ANON_KEY=your-supabase-anon-key
